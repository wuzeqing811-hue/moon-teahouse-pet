{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16",
    "rootDir": "src", "outDir": "dist", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "noEmitOnError": true, "types": ["node"]
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.ts", "src/preload.ts"]
}
