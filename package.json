{
  "name": "moon-teahouse-pet",
  "productName": "Moon Teahouse",
  "version": "1.9.0",
  "description": "月亮茶屋桌宠，支持角色换装、本地聊天和按需联网搜索。",
  "author": "Moon Teahouse Project",
  "private": true,
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "bake:clips": "npm run build && electron ./scripts/bake-sprites",
    "start": "npm run build && electron-forge start",
    "test": "npm run build && node --test test/*.test.cjs",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@types/node": "24.10.1",
    "electron": "45.3.4",
    "typescript": "5.9.3"
  }
}
